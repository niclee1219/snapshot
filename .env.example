# ── Clerk (create app at https://dashboard.clerk.com) ─────────────────────────
# Enable "Restricted" sign-up mode in Clerk dashboard → User & Authentication →
# Restrictions, so only invited emails can register.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in

# ── R2 S3 API credentials (for presigned uploads) ─────────────────────────────
# Cloudflare dashboard → R2 → Manage API tokens → Create (Object Read & Write,
# scoped to the pixolateds-media bucket).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=pixolateds-media

# ── App secrets ────────────────────────────────────────────────────────────────
# Used to sign the PIN-access cookies. Any long random string:
#   openssl rand -hex 32
PIN_COOKIE_SECRET=...

# In production these are set as Worker secrets instead:
#   wrangler secret put CLERK_SECRET_KEY
#   wrangler secret put R2_ACCESS_KEY_ID
#   wrangler secret put R2_SECRET_ACCESS_KEY
#   wrangler secret put R2_ACCOUNT_ID
#   wrangler secret put PIN_COOKIE_SECRET
# NEXT_PUBLIC_* values are inlined at build time from .env.
